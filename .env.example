ALLOWED_IMAGE_TYPES="jpg,jpeg,png,webp"
MAX_IMAGES_PER_REVIEW=5

# ============================================
# Payment Configuration
# ============================================
# This client uses CASH_ON_DELIVERY only
# Online payment gateways are disabled

# ============================================
# Logging Configuration
